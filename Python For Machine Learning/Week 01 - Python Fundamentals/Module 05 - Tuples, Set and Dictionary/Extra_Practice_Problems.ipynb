    "## J. Count Letters"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "1a797b55-e49d-469c-a9bd-9d4bc2df91e4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      " regff\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "e : 1\n",
      "f : 2\n",
      "g : 1\n",
      "r : 1\n"
     ]
    }
   ],
   "source": [
    "s = input()\n",
    "count = {}\n",
    "for c in s:\n",
    "    count[c] = count.get(c, 0) + 1\n",
    "for k in sorted(count.keys()):\n",
    "    print(f\"{k} : {count[k]}\")"
   ]
  },
